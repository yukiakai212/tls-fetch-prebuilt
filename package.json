{
  "name": "@yukiakai/tls-fetch",
  "version": "2.0.2",
  "description": "Rust native HTTP client emulating real browser TLS handshakes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "releaseBinary": "bin",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "CHANGELOG.md",
    "bin/*",
    "dist/*"
  ],
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "napi": {
    "binaryName": "tls-fetch"
  },
  "scripts": {
    "test": "npm run build && npx vitest run --reporter verbose --coverage",
    "test:release": "npx vitest run --reporter verbose --coverage && npm run test:sandbox",
    "test:sandbox": "npx sandbox && npx tsx ./__tests__/sandbox.ts",
    "format": "prettier --write **/*.{js,ts} && cargo fmt",
    "format:check": "prettier --check **/*.{js,ts} && cargo fmt --check",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "release": "npm run build:release && npm run build:ts",
    "build": "npx napi build --platform --package-json-path package.json -o bin && tsup",
    "build:ts": "npx tsup",
    "build:release": "npx napi build --release --platform --package-json-path package.json -o bin --target",
    "docs": "npx typedoc"
  },
  "keywords": [
    "tls-fetch",
    "Rust",
    "TLS",
    "HTTP client"
  ],
  "author": "Yuki_akai",
  "homepage": "https://github.com/yukiakai212/tls-fetch-prebuilt",
  "engines": {
    "node": ">= 16"
  },
  "maintainers": [
    {
      "name": "Yuki_akai",
      "homepage": "https://github.com/yukiakai212"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiakai212/tls-fetch-prebuilt.git"
  },
  "bugs": {
    "url": "https://github.com/yukiakai212/tls-fetch-prebuilt/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@node-rs/helper": "^1.6.0",
    "@yukiakai/find-up": "^1.1.5",
    "vanipath": "^1.0.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.32.0",
    "@napi-rs/cli": "^3.1.5",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.0.0",
    "eslint": "^9.32.0",
    "pkg-sandbox": "^1.0.1",
    "prettier": "^3.6.2",
    "proxy-chain": "^2.5.9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
