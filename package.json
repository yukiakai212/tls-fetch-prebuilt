{
  "name": "@yukiakai/tls-fetch",
  "version": "6.0.0",
  "description": "Rust native HTTP client emulating real browser TLS handshakes.",
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    "types": "./dist/public.d.ts",
    "import": "./dist/public.js",
    "require": "./dist/public.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "dist/*"
  ],
  "scripts": {
    "test": "npx vitest run --reporter verbose --coverage",
    "test:node": "npm run build:native:development && npm run test",
    "typecheck:workspace": "tsc -p tsconfig.workspace.json",
    "generate:types": "npx type-export-builder generate -p src/_public.ts",
    "build": "npx tsup",
    "build:public": "npm run generate:types && tsup --config tsup.public.config.ts",
    "build:native:development": "npm run build --workspace=@tls-fetch/addon",
    "docs": "npx typedoc",
    "prepare:artifact": "tsx workspace/release/prepareArtifact.ts",
    "prepare": "echo is-ci || husky"
  },
  "keywords": [
    "tls-fetch",
    "Rust",
    "TLS",
    "HTTP client"
  ],
  "author": "Yuki_akai",
  "homepage": "https://github.com/yukiakai212/tls-fetch-prebuilt",
  "funding": "https://github.com/sponsors/yukiakai212",
  "engines": {
    "node": ">= 16"
  },
  "maintainers": [
    {
      "name": "Yuki_akai",
      "homepage": "https://github.com/yukiakai212"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiakai212/tls-fetch-prebuilt.git"
  },
  "bugs": {
    "url": "https://github.com/yukiakai212/tls-fetch-prebuilt/issues"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@tls-fetch/addon": "*"
  },
  "optionalDependencies": {
    "@tls-fetch/addon-linux-x64-gnu": "6.0.0",
    "@tls-fetch/addon-linux-arm64-gnu": "6.0.0",
    "@tls-fetch/addon-linux-x64-musl": "6.0.0",
    "@tls-fetch/addon-linux-arm64-musl": "6.0.0",
    "@tls-fetch/addon-linux-arm-gnueabihf": "6.0.0",
    "@tls-fetch/addon-win32-x64-msvc": "6.0.0",
    "@tls-fetch/addon-win32-arm64-msvc": "6.0.0",
    "@tls-fetch/addon-win32-ia32-msvc": "6.0.0",
    "@tls-fetch/addon-darwin-arm64": "6.0.0",
    "@tls-fetch/addon-darwin-x64": "6.0.0",
    "@tls-fetch/addon-freebsd-x64": "6.0.0"
  }
}
